# ---- Clean URLs (no .html) ----
RewriteEngine On

# Stop mod_dir from adding a trailing slash when a name matches a real
# directory (blog/, case-studies/, services/). Without this, /case-studies
# would 301 to /case-studies/ and shadow the case-studies.html listing.
DirectorySlash Off

# Redirect /index.html and /index -> site root (canonical home)
RewriteCond %{THE_REQUEST} \s/(.+/)?index(\.html)?[\s?] [NC]
RewriteRule ^(.+/)?index(\.html)?$ /%1 [R=301,L]

# Externally redirect direct .html requests to the extensionless URL (301)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- Renamed case studies: preserve link equity from the old slugs ----
# Old URLs were /case-studies/mydigisence (and the capitalised /Mydigisence
# variant that used to be canonical) and /case-studies/prodigichat.
# [NC] so the mixed-case inbound links land here too.
RewriteRule ^case-studies/mydigisence/?$ /case-studies/mydigisense-digital-presence-marketplace-platform [R=301,L,NC]
RewriteRule ^case-studies/prodigichat/?$ /case-studies/prodigichat-whatsapp-marketing-automation-platform [R=301,L,NC]

# ---- Retired service pages: merged into the 8-service lineup ----
RewriteRule ^services/web-design(\.html)?/?$ /services/web-development [R=301,L,NC]
RewriteRule ^services/frontend-development(\.html)?/?$ /services/web-development [R=301,L,NC]
RewriteRule ^services/performance-seo(\.html)?/?$ /services/cloud-devops-services [R=301,L,NC]
RewriteRule ^services/whatsapp-business-api-development(\.html)?/?$ /services/api-backend-development [R=301,L,NC]
RewriteRule ^services/meta-api-integration(\.html)?/?$ /services/api-backend-development [R=301,L,NC]
RewriteRule ^services/website-maintenance-support(\.html)?/?$ /services/cloud-devops-services [R=301,L,NC]

# Internally rewrite extensionless URL to the real .html file.
# Checking the .html file FIRST means /case-studies serves case-studies.html
# even though a case-studies/ directory also exists.
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Serve directory root as its index (so "/" -> index.html)
DirectoryIndex index.html

# ---- Performance: compression (Core Web Vitals) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml     application/javascript application/x-javascript application/json     application/ld+json image/svg+xml application/xml text/javascript
</IfModule>

# ---- Performance: browser caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed/static assets - long cache
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType video/mp4                "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"
  # HTML must revalidate so content edits go live immediately
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|mp4|css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ---- Correct MIME types ----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/ld+json .jsonld
</IfModule>

# ---- Nice-to-haves ----
# Custom 404 (optional): ErrorDocument 404 /404.html

# Do not list directory contents
Options -Indexes
